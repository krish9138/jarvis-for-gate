  "study_tactics": [
    {"name": "Spaced Repetition", "detail": "Review notes after 1 day -> 3 days -> 7 days -> 21 days. Use Anki or handwritten flashcards for formulas."},
    {"name": "Active Recall", "detail": "Close book, write all formulas from memory daily. Struggle = learning; easy = review is needed."},
    {"name": "Mock Test Simulation", "detail": "Solve 2 mock tests per week from December. Simulate real conditions (3 hrs, no breaks, same time as GATE)."},
    {"name": "Focus Mode", "detail": "Phone in another room. Use Forest app or airplane mode. One subject per slot -- no multi-tasking."},
    {"name": "Synergy Method", "detail": "If college teaches a subject this semester, make it the GATE focus too -- saves ~30% total study time."},
    {"name": "Pomodoro / Deep Work", "detail": "25 min study + 5 min break. For 2-hr sessions: 4 cycles. Build exam endurance gradually."}
  ],
