# ==========================================
# GATE JARVIS - Environment Configuration
# ==========================================
# Create a copy of this file named ".env" and add your real API keys.
# NEVER commit your real .env file to GitHub or version control!

# Option 1: OpenAI API Key (For GPT-4o / GPT-4o-mini & OpenAI Embeddings)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Option 2: Google Gemini API Key (Free tier available)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Preferred AI Provider ('openai' or 'gemini')
AI_PROVIDER=gemini

# Database & App Settings
DATABASE_NAME=gate_jarvis.db
APP_TITLE=GATE JARVIS - AI Study Companion
